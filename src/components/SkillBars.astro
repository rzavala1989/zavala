---
const categories = [
  { name: 'Frontend', level: 95, years: '9+', color: '#8b7355' },
  { name: 'Backend', level: 90, years: '8+', color: '#a0845c' },
  { name: 'Databases', level: 85, years: '8+', color: '#7a6b5e' },
  { name: 'Cloud / DevOps', level: 80, years: '6+', color: '#9b8b7a' },
  { name: 'Testing', level: 85, years: '7+', color: '#6b6560' },
];
---

<section class="skillbars-section" id="proficiency">
  <h2 class="section-heading">Proficiency</h2>
  <div class="skillbars">
    {categories.map((cat, i) => (
      <div class="skillbar" style={`--bar-width: ${cat.level}%; --bar-color: ${cat.color}; --delay: ${i * 0.12}s`}>
        <div class="skillbar-header">
          <span class="skillbar-name">{cat.name}</span>
          <span class="skillbar-years">{cat.years} years</span>
        </div>
        <div class="skillbar-track">
          <div class="skillbar-fill"></div>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.3 }
  );

  document.querySelectorAll('.skillbar').forEach((bar) => {
    observer.observe(bar);
  });
</script>

<style>
  .skillbars-section {
    padding: var(--section-padding) 1.5rem;
    max-width: 720px;
    margin: 0 auto;
  }

  .section-heading {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    margin-bottom: 3rem;
    text-align: center;
  }

  .skillbars {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .skillbar {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.5s var(--ease-out), transform 0.5s var(--ease-out);
    transition-delay: var(--delay);
  }

  .skillbar.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .skillbar-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.5rem;
  }

  .skillbar-name {
    font-weight: 500;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
  }

  .skillbar-years {
    font-size: 0.8rem;
    color: var(--color-muted);
    letter-spacing: 0.05em;
  }

  .skillbar-track {
    width: 100%;
    height: 8px;
    background: rgba(200, 194, 188, 0.3);
    border-radius: 4px;
    overflow: hidden;
  }

  .skillbar-fill {
    height: 100%;
    width: 0;
    background: var(--bar-color);
    border-radius: 4px;
    transition: width 1s var(--ease-out);
    transition-delay: var(--delay);
  }

  .skillbar.visible .skillbar-fill {
    width: var(--bar-width);
  }

  @media (max-width: 480px) {
    .skillbars-section {
      padding-left: 1rem;
      padding-right: 1rem;
    }
  }
</style>
