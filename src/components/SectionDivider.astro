---
interface Props {
  num?: string;
  title: string;
  class?: string;
}

const { num, title, class: className = '' } = Astro.props;
---

<div class={`section-divider ${className}`}>
  <div class="parallax-bg" aria-hidden="true"></div>
  <div class="divider-content">
    <h2 class="divider-title">{title}</h2>
    <slot />
  </div>
</div>

<style>
  .section-divider {
    position: relative;
    width: 100%;
    min-height: clamp(6.5rem, 10vh, 9rem);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    margin: 2.25rem 0 3rem;
  }

  .section-divider.no-margin-bottom {
    margin-bottom: 0;
    border-bottom: none;
  }

  .parallax-bg {
    position: absolute;
    inset: 0;
    background-image: url('/images/parallax-texture.jpg');
    background-attachment: fixed;
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
    z-index: 0;
    filter: contrast(1.1) brightness(0.86);
  }

  .parallax-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(26, 26, 26, 0.42), rgba(26, 26, 26, 0.76));
    mix-blend-mode: multiply;
  }

  .divider-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    color: var(--paper);
    padding: 1.5rem 2rem;
  }

  .divider-title {
    font-family: var(--font-heading);
    font-size: clamp(2.7rem, 6vw, 4.7rem);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: var(--tracking-tight);
    font-style: italic;
    text-shadow: 0 4px 24px rgba(0,0,0,0.4);
  }

  @media (max-width: 768px) {
    .parallax-bg {
      background-attachment: scroll;
    }
  }
</style>
