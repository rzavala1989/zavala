          </svg>
          GitHub
        </a>
        <a class="hero-link" href="https://linkedin.com/in/rzavala1989" target="_blank" rel="noopener noreferrer">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          LinkedIn
        </a>
      </div>
    </div>
    <div class="hero-image">
      <img src="/images/headshot-hero.png" alt="Ricardo Zavala" width="380" height="460" loading="eager" />
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 2rem 1.5rem;
  }

  .hero-content {
    max-width: var(--content-max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
    width: 100%;
  }

  .hero-text {
    max-width: 520px;
  }

  .hero-name {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(2.8rem, 8vw, 5.5rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 0.8s var(--ease-out) 0.2s forwards;
  }

  .hero-title {
    font-weight: 500;
    font-size: clamp(0.85rem, 2vw, 1.1rem);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-secondary);
    margin-top: 1.2rem;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 0.8s var(--ease-out) 0.35s forwards;
  }

  .hero-location {
    font-size: 0.9rem;
    color: var(--color-muted);
    margin-top: 0.4rem;
    letter-spacing: 0.05em;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 0.8s var(--ease-out) 0.45s forwards;
  }

  .hero-bio {
    font-size: clamp(0.9rem, 1.5vw, 1rem);
    line-height: 1.7;
    color: var(--color-secondary);
    margin-top: 2rem;
    max-width: 28rem;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 0.8s var(--ease-out) 0.55s forwards;
  }

  .hero-links {
    display: flex;
    gap: 1.5rem;
    margin-top: 2.4rem;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 0.8s var(--ease-out) 0.65s forwards;
  }

  .hero-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-text);
    text-decoration: none;
    letter-spacing: 0.03em;
    padding: 0.4rem 0;
    position: relative;
    transition: color 0.3s ease;
  }

  .hero-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background-color: var(--color-text);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.4s var(--ease-out);
  }

  .hero-link:hover {
    color: var(--color-accent);
  }

  .hero-link:hover::after {
    background-color: var(--color-accent);
    transform: scaleX(1);
    transform-origin: left;
  }

  .hero-image {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    opacity: 0;
    animation: fadeIn 1s var(--ease-out) 0.4s forwards;
  }

  .hero-image::before {
    content: '';
    position: absolute;
    width: 340px;
    height: 340px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(139, 115, 85, 0.1) 0%, transparent 70%);
    z-index: 0;
  }

  .hero-image img {
    position: relative;
    z-index: 1;
    max-width: 100%;
    height: auto;
    max-height: 520px;
    object-fit: contain;
  }

  @media (max-width: 768px) {
    .hero-content {
      grid-template-columns: 1fr;
      gap: 2rem;
      text-align: center;
    }

    .hero-text {
      order: 2;
      max-width: 100%;
    }

    .hero-image {
      order: 1;
    }

    .hero-image img {
      max-height: 320px;
    }

    .hero-image::before {
      width: 240px;
      height: 240px;
    }

    .hero-bio {
      max-width: 100%;
    }

    .hero-links {
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .hero {
      padding: 1.5rem 1rem;
    }

    .hero-image img {
      max-height: 260px;
    }
  }
</style>
