<div class="masthead">
  <span class="masthead-mark">RZ</span>
  <span class="masthead-rule" aria-hidden="true"></span>
  <span class="masthead-meta">VOL. IX · HENDERSON, NV · MMXXVI</span>
  <span class="masthead-rule" aria-hidden="true"></span>
  <span class="masthead-meta">PORTFOLIO, No. 01</span>
</div>

<section class="hero" id="hero">
  <div class="hero-content">
    <div class="hero-text">
      <p class="hero-tagline">
        <span class="hero-tagline-num">01</span>
        <span class="hero-tagline-rule" aria-hidden="true"></span>
        The Engineer
      </p>
      <h1 class="hero-name">Ricardo<br/>Zavala</h1>
      <p class="hero-title">Staff Software Engineer</p>
      <p class="hero-location">Henderson, NV</p>
      <p class="hero-bio">
