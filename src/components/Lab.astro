---
import SectionDivider from './SectionDivider.astro';
import { experiments, getTechLogos } from '../data/portfolio';
---

<SectionDivider num="03" title="The Lab." />

<section class="lab-section" id="lab">
  <div class="lab-inner">
    <p class="lab-intro">Weekend-scope builds on public data. Smaller than the plates, held to the same bar.</p>
    <div class="lab-list">
      {experiments.map((exp) => {
        const logos = getTechLogos(exp.stack);
        return (
          <article class="lab-card">
            <div class="lab-head">
              <span class="lab-label">{exp.label}</span>
              <h3 class="lab-title"><a href={`/work/${exp.slug}/`}>{exp.title}</a></h3>
              {exp.question && <p class="lab-question">{exp.question}</p>}
            </div>
            <p class="lab-description">{exp.description}</p>
            {exp.meta && <p class="lab-meta">{exp.meta}</p>}
            {logos.length > 0 && (
              <div class="lab-logos" aria-label={`Technologies: ${logos.map(l => l.name).join(', ')}`}>
                {logos.map((logo) => (
                  <span class="tech-badge" title={logo.name}>
                    <img src={logo.src} alt={logo.name} width="16" height="16" loading="lazy" decoding="async" class="tech-icon" />
                    <span class="tech-name">{logo.name}</span>
                  </span>
                ))}
              </div>
            )}
            <div class="lab-links">
              <a class="link" href={`/work/${exp.slug}/`}>Project notes <span aria-hidden="true">&rarr;</span></a>
              {exp.liveUrl && (
                <a class="link" href={exp.liveUrl} target="_blank" rel="noopener noreferrer">
                  {exp.liveLabel} <span aria-hidden="true">&rarr;</span>
                </a>
              )}
              <a class="link" href={exp.sourceUrl} target="_blank" rel="noopener noreferrer">
                Source <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .lab-section {
    padding: 0 1.5rem var(--section-padding);
  }

  .lab-inner {
    max-width: var(--content-max-width);
    margin: 0 auto;
  }

  .lab-intro {
    font-size: var(--fs-lead);
    line-height: var(--leading-body);
    color: var(--color-secondary);
    text-align: center;
    margin: -1.5rem auto 3rem;
    max-width: 34rem;
  }

  .lab-list {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    max-width: 46rem;
    margin: 0 auto;
  }

  .lab-card {
    border: var(--border-hair);
    background-color: var(--paper);
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }

  .lab-label {
    display: inline-block;
    font-size: var(--fs-eyebrow);
    font-weight: 500;
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 0.6rem;
  }

  .lab-title {
    font-family: var(--font-heading);
    font-size: var(--fs-h3);
    font-weight: 400;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    margin-bottom: 0.4rem;
  }

  .lab-title a {
    color: inherit;
    text-decoration: none;
  }

  .lab-title a:hover,
  .lab-title a:focus-visible {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .lab-question {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--bronze-4);
    margin-bottom: 1.2rem;
  }

  .lab-description {
    font-size: var(--fs-body);
    line-height: var(--leading-body);
    color: var(--color-secondary);
    margin-bottom: 1.8rem;
  }

  .lab-meta {
    font-size: var(--fs-meta);
    letter-spacing: var(--tracking-wide);
    color: var(--color-muted);
    border-top: var(--border-hair);
    border-bottom: var(--border-hair);
    padding: 0.7rem 0;
    margin-bottom: 1.5rem;
  }

  .lab-logos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.6rem;
    margin-bottom: 1.5rem;
  }

  .tech-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.5rem;
    background: var(--paper-alt);
    border: var(--border-hair);
    border-radius: var(--radius-sm);
    transition: border-color var(--dur-fast) ease, background-color var(--dur-fast) ease;
  }

  .tech-badge:hover {
    border-color: var(--bronze);
    background: var(--paper-deep);
  }

  .tech-icon {
    width: 14px;
    height: 14px;
    object-fit: contain;
    display: block;
    filter: grayscale(0.2) contrast(0.9);
  }

  .tech-name {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--color-secondary);
    line-height: 1;
  }

  .tech-badge:hover .tech-name {
    color: var(--color-text);
  }

  .lab-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  @media (max-width: 480px) {
    .lab-section {
      padding-left: 1rem;
      padding-right: 1rem;
    }
  }
</style>