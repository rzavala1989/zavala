---
// Mini builds: hackathon-scope projects that earn a line, not a plate. Structured
// as a list so future entries slot in without layout work.
const experiments = [
  {
    label: 'Civic data · Hackathon build',
    title: 'Emergency Lifeline Auditor',
    question: 'When the next disaster hits, can this county hear the warning and move?',
    description:
      'Five federal datasets joined on county FIPS (CDC Social Vulnerability Index, FEMA National Risk Index, CDC PLACES, HHS emPOWER, OpenFEMA declarations) feed derived metrics for digital alert risk, daytime population surge, expected impact, and power-dependent residents. A zoomable choropleth, a severity-banded table, its map legend, and a per-county dossier all read one shared color scale, and every filter and selection serializes to the URL so an analyst can send a colleague the exact view.',
    meta: '3,144 counties · 5 federal datasets · 6 derived metrics',
    stack: 'Next.js 16 · React 19 · TypeScript · TanStack Table · react-simple-maps · Vitest',
    liveLabel: 'Live App',
    liveUrl: 'https://ricardo-svi-tool.vercel.app',
    sourceUrl: 'https://github.com/rzavala1989/ricardo-svi-tool',
  },
];
---

<section class="lab-section" id="lab">
  <div class="lab-inner">
    <p class="section-mark">§ 03</p>
    <h2 class="section-heading">The <em>Lab.</em></h2>
    <p class="lab-intro">Weekend-scope builds on public data. Smaller than the plates, held to the same bar.</p>
    <div class="lab-list">
      {experiments.map((exp) => (
        <article class="lab-card">
          <div class="lab-head">
            <span class="lab-label">{exp.label}</span>
            <h3 class="lab-title">{exp.title}</h3>
            <p class="lab-question">{exp.question}</p>
          </div>
          <p class="lab-description">{exp.description}</p>
          <p class="lab-meta">{exp.meta}</p>
          <p class="lab-stack">{exp.stack}</p>
          <div class="lab-links">
            <a class="link" href={exp.liveUrl} target="_blank" rel="noopener noreferrer">
              {exp.liveLabel} <span aria-hidden="true">&rarr;</span>
            </a>
            <a class="link" href={exp.sourceUrl} target="_blank" rel="noopener noreferrer">
              Source <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .lab-section {
    padding: var(--section-padding) 1.5rem;
  }

  .lab-inner {
    max-width: var(--content-max-width);
    margin: 0 auto;
  }

  .lab-intro {
    font-size: var(--fs-lead);
    line-height: var(--leading-body);
    color: var(--color-secondary);
    text-align: center;
    margin: -1.5rem auto 3rem;
    max-width: 34rem;
  }

  .lab-list {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    max-width: 46rem;
    margin: 0 auto;
  }

  .lab-card {
    border: var(--border-hair);
    background-color: var(--paper);
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }

  .lab-label {
    display: inline-block;
    font-size: var(--fs-eyebrow);
    font-weight: 500;
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 0.6rem;
  }

  .lab-title {
    font-family: var(--font-heading);
    font-size: var(--fs-h3);
    font-weight: 400;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    margin-bottom: 0.4rem;
  }

  .lab-question {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--bronze-4);
    margin-bottom: 1.2rem;
  }

  .lab-description {
    font-size: var(--fs-body);
    line-height: var(--leading-body);
    color: var(--color-secondary);
    margin-bottom: 1.8rem;
  }

  .lab-meta {
    font-size: var(--fs-meta);
    letter-spacing: var(--tracking-wide);
    color: var(--color-muted);
    border-top: var(--border-hair);
    border-bottom: var(--border-hair);
    padding: 0.7rem 0;
    margin-bottom: 1.5rem;
  }

  .lab-stack {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--color-secondary);
    margin-bottom: 1.5rem;
  }

  .lab-links {
    display: flex;
    gap: 1.5rem;
  }

  @media (max-width: 480px) {
    .lab-section {
      padding-left: 1rem;
      padding-right: 1rem;
    }
  }
</style>
