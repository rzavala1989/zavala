---
import SectionDivider from './SectionDivider.astro';

const calendlyUrl = import.meta.env.PUBLIC_CALENDLY_URL;
if (!calendlyUrl) {
  throw new Error('PUBLIC_CALENDLY_URL is not set. Add it to .env.local locally or to Vercel env vars before deploying.');
}
---

<SectionDivider num="Coda" title="Let's connect." />

<footer class="footer" id="contact">
  <div class="footer-content">
    <p class="footer-bio">Always interested in challenging problems, interesting teams, and the occasional bad pun.</p>
    <div class="footer-links">
      <a class="link" href="https://github.com/rzavala1989" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a class="link" href={calendlyUrl} target="_blank" rel="noopener noreferrer">Book a Chat</a>
      <a class="link" href="mailto:zavala.ricardo.m@gmail.com">Email</a>
    </div>
  </div>
  <div class="footer-mark" aria-hidden="true"><span>Ricardo Zavala</span></div>
  <div class="footer-bottom">
    <p class="colophon">Set in <em>Instrument Serif</em> &amp; Satoshi · Astro 5 + D3 · No JS frameworks · Henderson, NV</p>
    <p class="copy">&copy; MMXXVI Ricardo Zavala · zavala.pro</p>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--paper-deep);
    padding: 0 1.5rem 2rem;
  }

  .footer-content {
    max-width: var(--content-max-width);
    margin: 0 auto;
    text-align: center;
  }



  .footer-bio {
    font-size: clamp(0.9rem, 1.3vw, 1rem);
    line-height: 1.6;
    color: var(--color-secondary);
    max-width: 28rem;
    margin: 0 auto 2rem;
  }

  .footer-links {
    display: flex;
    justify-content: center;
    gap: 2rem;
  }

  .footer-mark {
    max-width: var(--content-max-width);
    margin: 5rem auto 0;
    overflow: hidden;
    user-select: none;
  }
  .footer-mark span {
    display: block;
    font-family: var(--font-heading);
    font-style: italic;
    font-size: clamp(4rem, 16vw, 12rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1px var(--color-divider);
    text-align: center;
    white-space: nowrap;
  }

  .footer-bottom {
    max-width: var(--content-max-width);
    margin: 2rem auto 0;
    text-align: center;
    padding-top: 2rem;
    border-top: var(--border-hair);
  }

  .colophon {
    font-size: var(--fs-meta);
    color: var(--color-muted);
    letter-spacing: var(--tracking-wide);
    margin-bottom: 0.4rem;
  }
  .colophon em {
    font-family: var(--font-heading);
    font-style: italic;
  }

  .copy {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    color: var(--color-muted);
    letter-spacing: var(--tracking-wide);
  }

  @media (max-width: 480px) {
    .footer {
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .footer-links {
      gap: 1.5rem;
    }
  }
</style>
