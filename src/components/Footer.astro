---
import SectionDivider from './SectionDivider.astro';

const calendlyUrl = import.meta.env.PUBLIC_CALENDLY_URL;
if (!calendlyUrl) {
  throw new Error('PUBLIC_CALENDLY_URL is not set. Add it to .env.local locally or to Vercel env vars before deploying.');
}
---

<div class="closing-section" id="contact">
  <SectionDivider title="Let's connect." class="no-margin-bottom">
    <div class="footer-cta">
      <div class="footer-links">
        <a class="link" href="/work/">Work</a>
        <a class="link" href="/writing/">Writing</a>
        <a class="link" href="/resume/">Resume</a>
        <a class="link" href="https://github.com/rzavala1989" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a class="link" href={calendlyUrl} target="_blank" rel="noopener noreferrer">Book a Chat</a>
        <a class="link" href="mailto:zavala.ricardo.m@gmail.com">Email</a>
      </div>
    </div>
  </SectionDivider>

  <footer class="footer">
    <div class="footer-mark" aria-hidden="true">
      <span>Ricardo Zavala</span>
    </div>

    <div class="footer-bottom">
      <p class="colophon">Set in <em>Instrument Serif</em> · Built with Astro 5 · Henderson, NV</p>
      <p class="copy">&copy; MMXXVI Ricardo Zavala · zavala.pro</p>
    </div>
  </footer>
</div>

<style>
  .closing-section {
    background: #11100f;
    color: var(--paper);
  }

  .footer-cta {
    margin-top: 1.25rem;
    text-align: center;
    color: var(--paper);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem;
  }

  .footer-links .link {
    color: var(--paper);
    text-decoration-color: rgba(246, 244, 240, 0.35);
  }

  .footer-links .link:hover,
  .footer-links .link:focus-visible {
    color: var(--paper);
    text-decoration-color: var(--paper);
  }

  .footer {
    padding: 1rem 1.5rem 2rem;
    border-top: 1px solid rgba(246, 244, 240, 0.08);
  }

  .footer-mark {
    max-width: var(--content-max-width);
    margin: 2.5rem auto 0;
    overflow: hidden;
    user-select: none;
  }

  .footer-mark span {
    display: block;
    font-family: var(--font-heading);
    font-style: italic;
    font-size: clamp(4rem, 13vw, 10rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1px rgba(246, 244, 240, 0.2);
    text-align: center;
    white-space: nowrap;
  }

  .footer-bottom {
    max-width: var(--content-max-width);
    margin: 1.5rem auto 0;
    text-align: center;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(246, 244, 240, 0.08);
  }

  .colophon {
    font-size: var(--fs-meta);
    color: rgba(246, 244, 240, 0.52);
    letter-spacing: var(--tracking-wide);
    margin-bottom: 0.35rem;
  }

  .colophon em {
    font-family: var(--font-heading);
    font-style: italic;
    color: rgba(246, 244, 240, 0.72);
  }

  .copy {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    color: rgba(246, 244, 240, 0.38);
    letter-spacing: var(--tracking-wide);
  }

  @media (max-width: 480px) {
    .footer {
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .footer-links {
      gap: 1.4rem;
    }

    .footer-mark {
      margin-top: 2rem;
    }
  }
</style>
