---
import SectionDivider from './SectionDivider.astro';

const calendlyUrl = import.meta.env.PUBLIC_CALENDLY_URL;
if (!calendlyUrl) {
  throw new Error('PUBLIC_CALENDLY_URL is not set. Add it to .env.local locally or to Vercel env vars before deploying.');
}
---

<SectionDivider title="Let's connect." class="no-margin-bottom">
  <footer class="footer-cta" id="contact">
    <div class="footer-links">
      <a class="link" href="/work/">Work</a>
      <a class="link" href="/faq/">FAQ</a>
      <a class="link" href="/resume/">Resume</a>
      <a class="link" href="https://github.com/rzavala1989" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a class="link" href={calendlyUrl} target="_blank" rel="noopener noreferrer">Book a Chat</a>
      <a class="link" href="mailto:zavala.ricardo.m@gmail.com">Email</a>
    </div>
    <p class="footer-meta">Ricardo Zavala · zavala.pro · Henderson, NV</p>
  </footer>
</SectionDivider>

<style>
  .footer-cta {
    margin-top: 1.5rem;
    text-align: center;
    color: var(--paper);
  }

  .footer-bio {
    font-size: clamp(0.9rem, 1.3vw, 1rem);
    line-height: 1.6;
    color: var(--paper);
    max-width: 28rem;
    margin: 0 auto 2rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem;
  }
  
  .footer-links .link {
    color: var(--paper);
    text-decoration-color: rgba(246, 244, 240, 0.4);
  }
  
  .footer-links .link:hover,
  .footer-links .link:focus-visible {
    color: var(--paper);
    text-decoration-color: var(--paper);
  }

  .footer-meta {
    margin-top: 1.5rem;
    font-size: var(--fs-eyebrow);
    color: rgba(250, 249, 247, 0.72);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  @media (max-width: 480px) {
    .footer-links {
      gap: 1.5rem;
    }
  }
</style>
