---
import SectionDivider from './SectionDivider.astro';
import { projects, getTechLogos } from '../data/portfolio';
---

<SectionDivider num="02" title="Selected Work." />

<section class="projects-section" id="projects">
  <div class="projects-list">
    {projects.map((project, i) => {
      const logos = getTechLogos(project.stack);
      return (
        <article class={`project-card ${i % 2 === 1 ? 'project-card--reversed' : ''}`}>
          <div class="project-preview-wrap">
            <a class="project-preview" href={`/work/${project.slug}/`} aria-label={`Read about ${project.title}`}>
              {project.image && <img src={project.image} alt={`${project.title} preview`} width="560" height="350" loading="lazy" />}
            </a>
            <div class="project-plate" aria-hidden="true">
              <span class="project-plate-label">{project.plate}</span>
              <span class="project-plate-title">{project.title}, live capture</span>
            </div>
          </div>
          <div class="project-info">
            <span class="project-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="project-label">{project.label}</span>
            <h3 class="project-title"><a href={`/work/${project.slug}/`}>{project.title}</a></h3>
            <p class="project-description">{project.description}</p>
            {logos.length > 0 && (
              <div class="project-logos" aria-label={`Technologies: ${logos.map(l => l.name).join(', ')}`}>
                {logos.map((logo) => (
                  <span class="tech-badge" title={logo.name}>
                    <img src={logo.src} alt={logo.name} width="16" height="16" loading="lazy" decoding="async" class="tech-icon" />
                    <span class="tech-name">{logo.name}</span>
                  </span>
                ))}
              </div>
            )}
            <div class="project-links">
              <a class="link" href={`/work/${project.slug}/`}>Project notes <span aria-hidden="true">&rarr;</span></a>
              {project.liveUrl && (
                <a class="link" href={project.liveUrl} target="_blank" rel="noopener noreferrer" aria-label={`View ${project.title} live`}>
                  {project.liveLabel} <span aria-hidden="true">&rarr;</span>
                </a>
              )}
              <a class="link" href={project.sourceUrl} target="_blank" rel="noopener noreferrer" aria-label={`View ${project.title} source code`}>
                Source <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </div>
        </article>
      );
    })}
  </div>
</section>

<style>
  .projects-section {
    padding: 0 1.5rem var(--section-padding);
    max-width: var(--content-max-width);
    margin: 0 auto;
  }

  .project-preview-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .project-plate {
    display: flex;
    gap: 1rem;
    font-size: var(--fs-eyebrow);
    color: var(--color-muted);
  }
  .project-plate-label {
    font-family: var(--font-body);
    font-weight: 500;
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
  }
  .project-plate-title {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 0.85rem;
    color: var(--color-secondary);
  }

  .project-num {
    display: block;
    font-family: var(--font-heading);
    font-style: italic;
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1;
    color: var(--bronze);
    margin-bottom: 1rem;
  }

  .projects-list {
    display: flex;
    flex-direction: column;
    gap: 5rem;
  }

  .project-card {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 3rem;
    align-items: center;
  }

  .project-preview-wrap {
    grid-column: 1 / 7;
  }

  .project-info {
    grid-column: 8 / 13;
  }

  .project-card--reversed .project-preview-wrap {
    grid-column: 7 / 13;
    order: 2;
  }

  .project-card--reversed .project-info {
    grid-column: 1 / 6;
    order: 1;
  }

  .project-preview {
    aspect-ratio: 16 / 10;
    border: var(--border-hair);
    overflow: hidden;
    display: block;
  }

  .project-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 180ms ease;
  }

  .project-preview:hover img,
  .project-preview:focus-visible img {
    transform: scale(1.015);
  }

  .project-info {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .project-label {
    display: inline-block;
    font-size: var(--fs-eyebrow);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 0.6rem;
  }

  .project-title {
    font-family: var(--font-heading);
    font-size: var(--fs-h2);
    font-weight: 400;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    margin-bottom: 1rem;
  }

  .project-title a {
    color: inherit;
    text-decoration: none;
  }

  .project-title a:hover,
  .project-title a:focus-visible {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .project-description {
    font-size: var(--fs-body);
    line-height: var(--leading-body);
    color: var(--color-secondary);
    margin-bottom: 1.2rem;
  }

  .project-logos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.6rem;
    margin-bottom: 1.5rem;
  }

  .tech-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.5rem;
    background: var(--paper-alt);
    border: var(--border-hair);
    border-radius: var(--radius-sm);
    transition: border-color var(--dur-fast) ease, background-color var(--dur-fast) ease;
  }

  .tech-badge:hover {
    border-color: var(--bronze);
    background: var(--paper-deep);
  }

  .tech-icon {
    width: 14px;
    height: 14px;
    object-fit: contain;
    display: block;
    filter: grayscale(0.2) contrast(0.9);
  }

  .tech-name {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--color-secondary);
    line-height: 1;
  }

  .tech-badge:hover .tech-name {
    color: var(--color-text);
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .project-card {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      direction: ltr;
    }

    .project-preview-wrap, .project-card--reversed .project-preview-wrap {
      grid-column: 1 / -1;
      order: 1;
    }

    .project-info, .project-card--reversed .project-info {
      grid-column: 1 / -1;
      order: 2;
    }
  }

  @media (max-width: 480px) {
    .projects-section {
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .projects-list {
      gap: 3.5rem;
    }
  }
</style>