---
import SectionDivider from './SectionDivider.astro';

const projects = [
  {
    label: 'DISTRIBUTED SYSTEM',
    title: 'Enroll',
    plate: 'PLATE I',
    description: 'Course registration system engineered for registration-day concurrency and data integrity. Built as a pnpm monorepo with a NestJS API and Next.js web application. Features a robust transaction model using Postgres row-level locks to serialize capacity checks and prevent over-enrollment, a Redis-backed BullMQ waitlist promotion worker, and an audit outbox pattern delivering committed events to MongoDB. Tested using Grafana k6 for load profiles and Testcontainers for concurrency.',
    stack: 'Next.js 16 · NestJS 11 · Prisma · PostgreSQL · Redis · MongoDB · BullMQ · Turborepo',
    sourceUrl: 'https://github.com/rzavala1989/enroll',
    image: '/images/enroll-preview.png',
  },
  {
    label: 'FULL-STACK PLATFORM',
    title: 'Nomadhood',
    plate: 'PLATE II',
    description: 'Neighborhood intelligence platform for digital nomads. Aggregates seven external APIs (WalkScore, Rentcast, FBI crime data, BLS economics, Eventbrite, newsdata.io, Unsplash) into a unified neighborhood profile. Features a cosine-similarity recommendation engine that learns from your review history across six lifestyle dimensions, a composite scoring algorithm that blends community ratings with objective data, and a news intelligence pipeline with signal classification and sentiment-based risk alerts. 19 Prisma models, 54 tRPC procedures, three access tiers.',
    stack: 'Next.js 15 · React 19 · tRPC v11 · Prisma 6 · PostgreSQL · MapLibre GL · Zod · Bun',
    liveLabel: 'Live App',
    liveUrl: 'https://nomadhood.vercel.app',
    sourceUrl: 'https://github.com/rzavala1989/nomadhood',
    image: '/images/nomadhood-preview.png',
  },
  {
    label: 'GAME ENGINE + 3D',
    title: 'Blaqjaq',
    plate: 'PLATE III',
    description: ' 3D blackjack with a 1951 Flamingo-era film noir aesthetic. The game engine is a pure reducer with zero React dependencies: 782 lines, 14 action types, full insurance/surrender/split mechanics. A complete basic strategy engine evaluates every decision against optimal play, and session analytics track your tendencies across hard, soft, and pair hands with P&L charting. The 3D scene uses React Three Fiber with five GLTF models, ACES filmic tone mapping, and procedural Web Audio API sound effects.',
    stack: 'React 19 · TypeScript · Three.js · React Three Fiber · Vitest · Vite 6',
    liveLabel: 'Play Live',
    liveUrl: 'https://blaqjaq.vercel.app',
    sourceUrl: 'https://github.com/rzavala1989/blaqjaq',
    image: '/images/blaqjaq-preview.png',
  },
];
---

<SectionDivider num="02" title="Selected Work." />

<section class="projects-section" id="projects">
  <div class="projects-list">
    {projects.map((project, i) => (
      <article class={`project-card ${i % 2 === 1 ? 'project-card--reversed' : ''}`}>
        <div class="project-preview-wrap">
          <div class="project-preview">
            <img src={project.image} alt={`${project.title} preview`} width="560" height="350" loading="lazy" />
          </div>
          <div class="project-plate">
            <span class="project-plate-label">{project.plate}</span>
            <span class="project-plate-title">{project.title}, live capture</span>
          </div>
        </div>
        <div class="project-info">
          <span class="project-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <span class="project-label">{project.label}</span>
          <h3 class="project-title">{project.title}</h3>
          <p class="project-description">{project.description}</p>
          <p class="project-stack">{project.stack}</p>
          <div class="project-links">
            {project.liveUrl && (
              <a class="link" href={project.liveUrl} target="_blank" rel="noopener noreferrer">
                {project.liveLabel} <span aria-hidden="true">&rarr;</span>
              </a>
            )}
            <a class="link" href={project.sourceUrl} target="_blank" rel="noopener noreferrer">
              Source <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .projects-section {
    padding: 0 1.5rem var(--section-padding);
    max-width: var(--content-max-width);
    margin: 0 auto;
  }

  .project-preview-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .project-plate {
    display: flex;
    gap: 1rem;
    font-size: var(--fs-eyebrow);
    color: var(--color-muted);
  }
  .project-plate-label {
    font-family: var(--font-body);
    font-weight: 500;
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
  }
  .project-plate-title {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 0.85rem;
    color: var(--color-secondary);
  }

  .project-num {
    display: block;
    font-family: var(--font-heading);
    font-style: italic;
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1;
    color: var(--bronze);
    margin-bottom: 1rem;
  }

  .projects-list {
    display: flex;
    flex-direction: column;
    gap: 5rem;
  }

  .project-card {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 3rem;
    align-items: center;
  }

  .project-preview-wrap {
    grid-column: 1 / 7;
  }

  .project-info {
    grid-column: 8 / 13;
  }

  .project-card--reversed .project-preview-wrap {
    grid-column: 7 / 13;
    order: 2;
  }

  .project-card--reversed .project-info {
    grid-column: 1 / 6;
    order: 1;
  }

  .project-preview {
    aspect-ratio: 16 / 10;
    border: var(--border-hair);
    overflow: hidden;
  }

  .project-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .project-info {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .project-label {
    display: inline-block;
    font-size: var(--fs-eyebrow);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 0.6rem;
  }

  .project-title {
    font-family: var(--font-heading);
    font-size: var(--fs-h2);
    font-weight: 400;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    margin-bottom: 1rem;
  }

  .project-description {
    font-size: var(--fs-body);
    line-height: var(--leading-body);
    color: var(--color-secondary);
    margin-bottom: 1.2rem;
  }

  .project-stack {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--color-secondary);
    margin-bottom: 1.5rem;
  }

  .project-links {
    display: flex;
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .project-card {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      direction: ltr;
    }

    .project-preview-wrap, .project-card--reversed .project-preview-wrap {
      grid-column: 1 / -1;
      order: 1;
    }

    .project-info, .project-card--reversed .project-info {
      grid-column: 1 / -1;
      order: 2;
    }
  }

  @media (max-width: 480px) {
    .projects-section {
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .projects-list {
      gap: 3.5rem;
    }
  }
</style>