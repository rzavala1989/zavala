---
const projects = [
  {
    label: 'FULL-STACK PLATFORM',
    title: 'Nomadhood',
    description: 'Neighborhood intelligence platform for digital nomads. Aggregates seven external APIs (WalkScore, Rentcast, FBI crime data, BLS economics, Eventbrite, newsdata.io, Unsplash) into a unified neighborhood profile. Features a cosine-similarity recommendation engine that learns from your review history across six lifestyle dimensions, a composite scoring algorithm that blends community ratings with objective data, and a news intelligence pipeline with signal classification and sentiment-based risk alerts. 19 Prisma models, 54 tRPC procedures, three access tiers.',
    stack: 'Next.js 15 · React 19 · tRPC v11 · Prisma 6 · PostgreSQL · MapLibre GL · Zod · Bun',
    liveLabel: 'Live App',
    liveUrl: 'https://nomadhood.vercel.app',
    sourceUrl: 'https://github.com/rzavala1989/nomadhood',
    image: '/images/nomadhood-preview.png',
  },
  {
    label: 'GAME ENGINE + 3D',
    title: 'Blaqjaq',
    description: ' 3D blackjack with a 1951 Flamingo-era film noir aesthetic. The game engine is a pure reducer with zero React dependencies: 782 lines, 14 action types, full insurance/surrender/split mechanics. A complete basic strategy engine evaluates every decision against optimal play, and session analytics track your tendencies across hard, soft, and pair hands with P&L charting. The 3D scene uses React Three Fiber with five GLTF models, ACES filmic tone mapping, and procedural Web Audio API sound effects.',
    stack: 'React 19 · TypeScript · Three.js · React Three Fiber · Vitest · Vite 6',
    liveLabel: 'Play Live',
    liveUrl: 'https://blaqjaq.vercel.app',
    sourceUrl: 'https://github.com/rzavala1989/blaqjaq',
    image: '/images/blaqjaq-preview.png',
  },
];
---

<section class="projects-section" id="projects">
  <h2 class="section-heading">Selected Work</h2>
  <div class="projects-list">
    {projects.map((project, i) => (
      <article class={`project-card ${i % 2 === 1 ? 'project-card--reversed' : ''}`}>
        <div class="project-preview">
          <img src={project.image} alt={`${project.title} preview`} width="560" height="350" loading="lazy" />
        </div>
        <div class="project-info">
          <span class="project-label">{project.label}</span>
          <h3 class="project-title">{project.title}</h3>
          <p class="project-description">{project.description}</p>
          <p class="project-stack">{project.stack}</p>
          <div class="project-links">
            <a class="project-link" href={project.liveUrl} target="_blank" rel="noopener noreferrer">
              {project.liveLabel} <span aria-hidden="true">&rarr;</span>
            </a>
            <a class="project-link" href={project.sourceUrl} target="_blank" rel="noopener noreferrer">
              Source <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
  );

  document.querySelectorAll('.project-card').forEach((card) => {
    observer.observe(card);
  });
</script>

<style>
  .projects-section {
    padding: var(--section-padding) 1.5rem;
    max-width: var(--content-max-width);
    margin: 0 auto;
  }

  .section-heading {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    margin-bottom: 3rem;
    text-align: center;
  }

  .projects-list {
    display: flex;
    flex-direction: column;
    gap: 5rem;
  }

  .project-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.6s var(--ease-out), transform 0.6s var(--ease-out);
  }

  .project-card.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .project-card--reversed {
    direction: rtl;
  }

  .project-card--reversed > * {
    direction: ltr;
  }

  .project-preview {
    aspect-ratio: 16 / 10;
    border: 1px solid var(--color-divider);
    overflow: hidden;
  }

  .project-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .project-info {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .project-label {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 0.6rem;
  }

  .project-title {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  .project-description {
    font-size: clamp(0.85rem, 1.3vw, 0.95rem);
    line-height: 1.7;
    color: var(--color-secondary);
    margin-bottom: 1.2rem;
  }

  .project-stack {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--color-secondary);
    margin-bottom: 1.5rem;
  }

  .project-links {
    display: flex;
    gap: 1.5rem;
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-text);
    text-decoration: none;
    letter-spacing: 0.03em;
    padding: 0.4rem 0;
    position: relative;
    transition: color 0.3s ease;
  }

  .project-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background-color: var(--color-text);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.4s var(--ease-out);
  }

  .project-link:hover {
    color: var(--color-accent);
  }

  .project-link:hover::after {
    background-color: var(--color-accent);
    transform: scaleX(1);
    transform-origin: left;
  }

  @media (max-width: 768px) {
    .project-card,
    .project-card--reversed {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      direction: ltr;
    }

    .project-preview {
      order: -1;
    }
  }

  @media (max-width: 480px) {
    .projects-section {
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .projects-list {
      gap: 3.5rem;
    }
  }
</style>