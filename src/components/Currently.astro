---
import SectionDivider from './SectionDivider.astro';

const calendlyUrl = import.meta.env.PUBLIC_CALENDLY_URL;

const items = [
  { label: 'LOOKING FOR', value: 'Staff or Senior Engineering roles on small, high-ownership teams.' },
  { label: 'STRONGEST IN', value: 'Distributed systems, API design, and data-intensive backends at scale.' },
  { label: 'READING', value: "Kleppmann's Designing Data-Intensive Applications." },
  { label: 'AVAILABILITY', value: 'Immediately available \u00b7 Remote US \u00b7 Full-time or contract.' },
];
---

<SectionDivider num="04" title="What I'm looking for." />

<section class="currently-section" id="currently">
  <div class="currently-inner">
    <dl class="currently-list">
      {items.map((item) => (
        <div class="currently-row">
          <dt class="currently-label">{item.label}</dt>
          <dd class="currently-value">{item.value}</dd>
        </div>
      ))}
      {calendlyUrl && (
        <div class="currently-row currently-cta">
          <dt class="currently-label" aria-hidden="true"></dt>
          <dd class="currently-value">
            <a class="link" href={calendlyUrl} target="_blank" rel="noopener noreferrer">
              Book a Chat <span aria-hidden="true">&rarr;</span>
            </a>
          </dd>
        </div>
      )}
    </dl>
  </div>
</section>

<style>
  .currently-section {
    padding: 0 1.5rem var(--section-padding);
  }

  .currently-inner {
    max-width: var(--content-max-width);
    margin: 0 auto;
  }

  .currently-list {
    margin: 0 auto;
    max-width: 52rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .currently-row {
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: 2rem;
    align-items: baseline;
  }
  
  .currently-cta {
    margin-top: 1rem;
  }

  .currently-label {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--fs-eyebrow);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--bronze);
    white-space: nowrap;
  }

  .currently-value {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--fs-body);
    line-height: var(--leading-body);
    color: var(--color-secondary);
  }

  @media (max-width: 768px) {
    .currently-row {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
  }

  @media (max-width: 480px) {
    .currently-section {
      padding-left: 1rem;
      padding-right: 1rem;
    }
  }
</style>
