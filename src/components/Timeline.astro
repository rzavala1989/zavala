---
import SectionDivider from './SectionDivider.astro';

const experience = [
  {
    company: 'Arkra',
    role: 'Co-Founding Backend Engineer',
    period: '2025 - Present',
    summary: 'Backend architecture and AI-assisted finance workflows.'
  },
  {
    company: 'Axon / Idaho National Laboratory',
    role: 'Senior and contract engineering',
    period: '2025',
    summary: 'Regulated data platforms and internal research systems.'
  },
  {
    company: 'Accenture Federal Services',
    role: 'Senior Full Stack Engineer',
    period: '2022 - 2025',
    summary: 'Large-scale federal GIS, API, and payment systems.'
  },
  {
    company: 'Cigna · Touch To · Zappos · Vegas.com',
    role: 'Product and platform engineering',
    period: '2016 - 2022',
    summary: 'Healthcare, commerce, real-time ordering, and customer-facing applications.'
  }
];
---

<SectionDivider title="Experience." />

<section class="experience-section" id="experience">
  <div class="experience-inner">
    <p class="experience-intro">
      Selected roles across regulated, high-scale, and early-stage products.
    </p>

    <div class="experience-grid">
      {experience.map((item) => (
        <article class="experience-card">
          <p class="experience-period">{item.period}</p>
          <h3>{item.company}</h3>
          <p class="experience-role">{item.role}</p>
          <p class="experience-summary">{item.summary}</p>
        </article>
      ))}
    </div>

    <a class="link resume-link" href="/resume/">Full experience <span aria-hidden="true">→</span></a>
  </div>
</section>

<style>
  .experience-section {
    background-color: var(--paper-alt);
    padding: 0 1.5rem var(--section-padding);
  }

  .experience-inner {
    max-width: var(--content-max-width);
    margin: 0 auto;
  }

  .experience-intro {
    max-width: 40rem;
    margin: 0 auto 2.5rem;
    text-align: center;
    color: var(--color-secondary);
    font-size: var(--fs-lead);
    line-height: var(--leading-body);
  }

  .experience-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 2.5rem;
    border-top: var(--border-hair);
  }

  .experience-card {
    padding: 1.6rem 0 1.8rem;
    border-bottom: var(--border-hair);
  }

  .experience-period {
    margin-bottom: 0.55rem;
    font-size: var(--fs-meta);
    font-weight: 500;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .experience-card h3 {
    font-family: var(--font-heading);
    font-size: var(--fs-h3);
    font-weight: 400;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
  }

  .experience-role {
    margin-top: 0.3rem;
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--color-secondary);
  }

  .experience-summary {
    margin-top: 0.8rem;
    max-width: 28rem;
    color: var(--color-secondary);
    font-size: var(--fs-body);
    line-height: 1.6;
  }

  .resume-link {
    margin-top: 2rem;
  }

  @media (max-width: 720px) {
    .experience-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .experience-section {
      padding-left: 1rem;
      padding-right: 1rem;
    }
  }
</style>
