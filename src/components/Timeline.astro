---
const jobs = [
  {
    era: 'Now',
    company: 'Arkra',
    title: 'Co-Founding Backend Engineer',
    period: '2025 - Present',
    summary: 'Architecting backend services for an AI-powered equipment finance platform. Building RESTful APIs with .NET 8 and Entity Framework Core, AI-driven underwriting pipelines in Python, and CI/CD with Azure DevOps.'
  },
  {
    company: 'Axon',
    title: 'Senior Full Stack Engineer',
    period: '2025',
    summary: 'Built secure, multi-tenant law enforcement data platforms with AI-powered enrichment pipelines at the global leader in connected public safety.'
  },
  {
    company: 'Idaho National Laboratory',
    title: 'Software Engineer (Contract)',
    period: 'Jun - Oct 2025',
    summary: 'Fixed-term contract at a U.S. Department of Energy national laboratory. Full stack .NET development using C#, .NET 8, MVC, Entity Framework, and SQL Server on internal research and infrastructure systems.'
  },
  {
    era: 'Federal & Enterprise',
    company: 'Accenture Federal Services',
    title: 'Senior Full Stack Engineer',
    period: '2022 - 2025',
    summary: 'Delivered high-scale applications for USPS serving millions of daily users, from real-time GIS mapping to PCI-compliant payment systems.'
  },
  {
    company: 'Cigna',
    title: 'Full Stack Engineer',
    period: '2022',
    summary: 'Worked on healthcare platforms serving millions of members, building shared component libraries and observability tooling.'
  },
  {
    company: 'Touch To',
    title: 'Frontend Engineer',
    period: '2021 - 2022',
    summary: 'Architected micro-frontend systems and real-time dashboards for digital ordering in hospitality and defense sectors.'
  },
  {
    era: 'Early Career',
    company: 'Zappos',
    title: 'Web and Mobile Developer',
    period: '2018 - 2021',
    summary: 'Built customer-facing e-commerce features at scale, including PWAs and payment systems handling 18M+ monthly transactions.'
  },
  {
    company: 'Vegas.com',
    title: 'Web Development Intern',
    period: '2016 - 2017',
    summary: 'Cut teeth on production web development at a major online travel platform. Built internal tooling and broke a few things along the way.'
  }
];
---

<section class="timeline-section" id="experience">
  <div class="timeline-inner">
  <p class="section-mark">§ 01</p>
  <h2 class="section-heading">A career, <em>plotted.</em></h2>
  <div class="timeline">
    {jobs.map((job) => (
      <>
        {job.era && (
          <div class="timeline-era">
            <span class="timeline-era-rule" aria-hidden="true"></span>
            <span class="timeline-era-label">{job.era}</span>
          </div>
        )}
        <div class="timeline-item">
          <div class={`timeline-marker ${job.period.includes('Present') ? 'is-current' : ''}`}></div>
          <div class="timeline-content">
            <span class="timeline-period">{job.period}</span>
            <h3 class="timeline-company">{job.company}</h3>
            <p class="timeline-title">{job.title}</p>
            <p class="timeline-summary">{job.summary}</p>
          </div>
        </div>
      </>
    ))}
  </div>
  </div>
</section>

<style>
  .timeline-section {
    background-color: var(--paper-alt);
    padding: var(--section-padding) 1.5rem;
  }

  .timeline-inner {
    max-width: var(--content-max-width);
    margin: 0 auto;
  }

  .timeline-era {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 2.5rem 0 1.5rem;
    padding-left: 0.5rem;
  }
  .timeline-era-rule {
    width: 1.5rem;
    height: 1px;
    background: var(--bronze);
  }
  .timeline-era-label {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1.1rem;
    color: var(--color-text);
  }

  .timeline {
    position: relative;
    padding-left: 2.5rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background-color: var(--color-divider);
  }

  .timeline-item {
    position: relative;
    padding-bottom: 3rem;
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  .timeline-marker {
    position: absolute;
    left: -2.5rem;
    top: 8px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: transparent;
    box-shadow: 0 0 0 1px var(--bronze);
    z-index: 1;
  }

  .timeline-marker.is-current {
    background-color: var(--bronze);
    box-shadow: 0 0 0 3px var(--paper-alt);
  }

  .timeline-content {
    padding-left: 0.5rem;
  }

  .timeline-period {
    display: inline-block;
    font-size: var(--fs-meta);
    font-weight: 500;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 0.3rem;
  }

  .timeline-company {
    font-family: var(--font-heading);
    font-size: var(--fs-h3);
    font-weight: 400;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
  }

  .timeline-title {
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--color-secondary);
    margin-top: 0.2rem;
  }

  .timeline-summary {
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--color-secondary);
    margin-top: 0.6rem;
    max-width: 36rem;
  }

  @media (max-width: 768px) {
    .timeline {
      padding-left: 2rem;
    }

    .timeline::before {
      left: 3px;
    }

    .timeline-marker {
      left: -2rem;
    }
  }

  @media (max-width: 480px) {
    .timeline-section {
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .timeline-item {
      padding-bottom: 2.5rem;
    }
  }
</style>
