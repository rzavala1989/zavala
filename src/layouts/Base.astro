---
import '../styles/tokens.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  ogType?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = 'Ricardo Zavala is a Staff Software Engineer in Henderson, Nevada building full-stack, distributed, and AI-assisted systems with React, TypeScript, Node.js, Python, PostgreSQL, and AWS.',
  image = '/images/headshot-hero.png',
  ogType = 'profile',
  structuredData,
} = Astro.props;

const site = Astro.site ?? new URL('https://zavala.pro');
const canonicalUrl = new URL(Astro.url.pathname, site);
const imageUrl = new URL(image, site);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Ricardo Zavala',
  url: site.toString(),
  image: new URL('/images/headshot-hero.png', site).toString(),
  jobTitle: 'Staff Software Engineer',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Henderson',
    addressRegion: 'NV',
    addressCountry: 'US',
  },
  sameAs: ['https://github.com/rzavala1989'],
  knowsAbout: [
    'React',
    'TypeScript',
    'Node.js',
    'Python',
    'Go',
    'PostgreSQL',
    'AWS',
    'Distributed systems',
    'AI systems',
  ],
};

const schemas = structuredData
  ? [personSchema, ...(Array.isArray(structuredData) ? structuredData : [structuredData])]
  : [personSchema];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Ricardo Zavala" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    {ogType === 'profile' && <meta property="profile:first_name" content="Ricardo" />}
    {ogType === 'profile' && <meta property="profile:last_name" content="Zavala" />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <link rel="preload" href="/fonts/satoshi/satoshi-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/satoshi/satoshi-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/satoshi/satoshi-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-serif/instrument-serif-regular-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/fonts/fonts.css" />
    <script type="application/ld+json" set:html={JSON.stringify(schemas)}></script>
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  *, *::before, *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    min-height: 100vh;
    overflow-x: hidden;
    font-family: var(--font-body);
    background-color: var(--color-bg);
    color: var(--color-text);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  @keyframes fadeIn {
    to {
      opacity: 1;
    }
  }
</style>
