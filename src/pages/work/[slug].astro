---
import Base from '../../layouts/Base.astro';
import { portfolioItems, type PortfolioItem } from '../../data/portfolio';

export function getStaticPaths() {
  return portfolioItems.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

interface Props { item: PortfolioItem; }
const { item } = Astro.props;
const description = `${item.title} by Ricardo Zavala. ${item.description}`;
const projectSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: item.title,
  description: item.description,
  codeRepository: item.sourceUrl,
  url: new URL(`/work/${item.slug}/`, Astro.site ?? 'https://zavala.pro').toString(),
  author: { '@type': 'Person', name: 'Ricardo Zavala', url: 'https://zavala.pro/' },
  programmingLanguage: item.stack,
  ...(item.liveUrl ? { targetProduct: { '@type': 'SoftwareApplication', name: item.title, url: item.liveUrl } } : {}),
};

const techArticleSchemas: Record<string, any> = {
  enroll: {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: 'Enroll: How I Stopped a Registration-Day Meltdown with PostgreSQL Row Locks',
    author: { '@type': 'Person', name: 'Ricardo Zavala', url: 'https://zavala.pro' },
    datePublished: '2025-01-15',
    articleSection: 'Distributed Systems',
    keywords: 'PostgreSQL, concurrency, row locking, outbox pattern, load testing'
  },
  nomadhood: {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: 'Nomadhood: Fixing Neighborhood Recommendations with pgvector',
    author: { '@type': 'Person', name: 'Ricardo Zavala', url: 'https://zavala.pro' },
    datePublished: '2025-01-15',
    articleSection: 'Full-stack Platform',
    keywords: 'pgvector, Next.js, recommendation engine, cosine similarity'
  },
  blaqjaq: {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: 'Blaqjaq: Decoupling Game State from React with a Pure Reducer',
    author: { '@type': 'Person', name: 'Ricardo Zavala', url: 'https://zavala.pro' },
    datePublished: '2025-01-15',
    articleSection: 'Game Engine',
    keywords: 'React, game engine, reducer, React Three Fiber, 3D'
  },
  'emergency-lifeline-auditor': {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: 'Emergency Lifeline Auditor: Unifying Federal Datasets for Disaster Response',
    author: { '@type': 'Person', name: 'Ricardo Zavala', url: 'https://zavala.pro' },
    datePublished: '2025-01-15',
    articleSection: 'Civic Data',
    keywords: 'data visualization, Next.js, dataset mapping, FIPS'
  }
};

const schemas = [projectSchema, techArticleSchemas[item.slug]].filter(Boolean);
---

<Base
  title={`${item.title} | Ricardo Zavala`}
  description={description}
  image={item.image}
  ogType="article"
  structuredData={schemas}
>
  <main class="project-page">
    <nav class="back-nav" aria-label="Breadcrumb"><a href="/">Ricardo Zavala</a> / <a href="/work/">Work</a> / {item.title}</nav>

    <header class="project-header">
      <p class="eyebrow">{item.label}</p>
      <h1>{item.title}</h1>
      {item.question && <p class="question">{item.question}</p>}
      <p class="lede">{item.description}</p>
      <div class="links">
        {item.liveUrl && <a href={item.liveUrl} target="_blank" rel="noopener noreferrer">{item.liveLabel} <span aria-hidden="true">↗</span></a>}
        <a href={item.sourceUrl} target="_blank" rel="noopener noreferrer">Source <span aria-hidden="true">↗</span></a>
      </div>
    </header>

    {item.image && (
      <figure class="preview">
        <img src={item.image} alt={`${item.title} application preview`} width="1120" height="700" />
        <figcaption>{item.plate ?? item.title} · portfolio capture</figcaption>
      </figure>
    )}

    <section class="details" aria-labelledby="engineering-notes">
      <div class="detail-block">
        <p class="detail-label">Stack</p>
        <p>{item.stack}</p>
      </div>
      {item.meta && <div class="detail-block"><p class="detail-label">Scope</p><p>{item.meta}</p></div>}
      <div class="detail-block wide">
        <h2 id="engineering-notes">Engineering notes</h2>
        {item.slug === 'enroll' && <>
          <h3>Concurrency hazards during registration surges</h3>
          <p>Course registration spikes create severe burst contention. At 8:00 AM on registration morning, 1,000 students submit requests within seconds for 40 available seats in high-demand sections. If parallel requests check available capacity before updating the seat count, multiple transactions evaluate the identical remaining count and commit. This creates over-enrollment.</p>

          <h3>Failure mode with optimistic concurrency control</h3>
          <p>The initial implementation relied on optimistic concurrency control using Prisma versioning tags. Under k6 stress testing with 500 concurrent virtual users, this approach degraded rapidly. Contending requests encountered version conflicts and executed automated application-level retries. The resulting retry storms saturated the connection pool, drove database CPU utilization to 100%, and caused 23 excess seat allocations due to non-atomic validation checks across concurrent processes.</p>

          <h3>Row-level pessimistic locking in PostgreSQL</h3>
          <p>To eliminate race conditions, the concurrency invariant moved directly into PostgreSQL using explicit <code>SELECT FOR UPDATE</code> locks inside isolated transactions. When a student initiates enrollment, NestJS acquires an exclusive row-level lock on the course section record. Concurrent requests for that same section block at the database layer until the active transaction resolves. The subsequent request reads the exact serialized seat count. In load tests, overall write throughput decreased by 15%, while seat overcommits dropped to zero.</p>

          <h3>Decoupling audit trails with the transactional outbox pattern</h3>
          <p>The architecture requires state changes in PostgreSQL, waitlist processing via BullMQ on Redis, and immutable audit logs in MongoDB. Directly writing to secondary data stores within the request lifecycle caused inconsistent states whenever network calls to MongoDB timed out after PostgreSQL committed. To isolate failures, the system writes enrollment updates and outbox events within a single ACID transaction in PostgreSQL. A separate background worker reads unprocessed outbox records, dispatches jobs to Redis, and synchronizes MongoDB. If secondary infrastructure goes down, registration continues without data loss.</p>

          <h3>Automated load verification with Testcontainers</h3>
          <p>Continuous integration pipelines execute load and transaction tests against real PostgreSQL and Redis instances spawned through Testcontainers. k6 scenarios ramp to 1,000 virtual users across multi-node configurations to enforce zero seat drift on every release.</p>
        </>}
        {item.slug === 'nomadhood' && <>
          <h3>Dimension cancellation in linear scoring algorithms</h3>
          <p>Remote workers evaluate locations across distinct preferences instead of generic averages. The initial recommendation engine used weighted linear averages across walkability, rent price, crime rates, and climate data. This caused false positives. A user who prioritized dense, transit-connected urban neighborhoods received recommendations for low-density retirement suburbs because high safety scores and cheap rent offset the total lack of walkability.</p>

          <h3>Vector embeddings and cosine similarity with pgvector</h3>
          <p>The recommendation pipeline was redesigned around PostgreSQL with the <code>pgvector</code> extension. Neighborhood profiles are modeled as normalized six-dimensional vectors representing density, living costs, safety percentiles, transit access, cultural venue frequency, and weather patterns. User preference vectors derive from saved locations and explicit weighting. A single cosine similarity query evaluates the structural shape of user preferences against neighborhood vectors, preventing high scores in one dimension from masking critical deficiencies in another.</p>

          <h3>Data ingestion and schema reconciliation across seven APIs</h3>
          <p>The platform aggregates records from seven external data providers, including Walk Score, Census ACS, OpenWeather, Mapbox, and regional crime databases. Each external feed features inconsistent coordinate precision, disparate update cadences, and missing fields. An ingestion worker built with Bun validates and normalizes incoming payloads against Zod schemas before persisting into 19 Prisma models. The API layer provides end-to-end type safety to React clients through 54 tRPC procedures.</p>

          <h3>Operational resilience in external sentiment processing</h3>
          <p>The neighborhood news pipeline ingests regional publications to flag emerging local disruptions. Rate limits and schema shifts from third-party news APIs caused silent ingestion failures when logging exceptions without a persistence queue. The pipeline now isolates third-party fetches into dedicated message queues with exponential backoff and dead-letter handling.</p>
        </>}
        {item.slug === 'blaqjaq' && <>
          <h3>State graph explosion in component lifecycles</h3>
          <p>Managing real-time game state directly inside React components introduced severe instability. The initial prototype tracked hands, chip stacks, split states, and dealer actions using distributed <code>useState</code> and <code>useEffect</code> hooks. As rules expanded to support split aces, double downs, surrender options, and dealer soft-17 checks, state transitions became vulnerable to component re-render timing. An edge case involving simultaneous split calculations during dealer blackjack evaluations triggered recursive state updates, causing the WebGL viewport to freeze and corrupting active table bankrolls.</p>

          <h3>Extracting a deterministic zero-dependency state machine</h3>
          <p>The game engine was completely separated from React into a pure TypeScript reducer spanning 782 lines and 14 explicit action types. The engine accepts an immutable state snapshot and an action payload, computing the subsequent game state with zero side effects or DOM dependencies. Card distribution uses a Fisher-Yates shuffle seeded with cryptographic randomness.</p>

          <h3>Automated strategy verification and analytics</h3>
          <p>Because the core engine has no UI dependencies, the test suite executes 50,000 automated hand simulations across the complete Basic Strategy decision table in 40 milliseconds using Vitest. An integrated strategy analysis module evaluates player decisions against mathematically optimal play at runtime, recording deviation trends across hard totals, soft totals, pair splits, and surrender scenarios.</p>

          <h3>Decoupling Three.js scene graphs from game state</h3>
          <p>React Three Fiber acts solely as a passive render layer observing game state transitions. The 3D viewport manages camera movement, card mesh transforms, chip animations, and ACES filmic tone mapping without mutating gameplay variables. Spatial audio effects run through procedural Web Audio API synthesis instead of remote audio files, eliminating asset network latency.</p>
        </>}
        {item.slug === 'emergency-lifeline-auditor' && <>
          <h3>Disparate federal schemas and conflicting risk classifications</h3>
          <p>During severe climate emergencies, disaster response coordinators require rapid synthesis across disparate federal databases. The initial build loaded five federal datasets (CDC Social Vulnerability Index, FEMA National Risk Index, Census ACS, FCC Broadband maps, and HHS emPOWER electricity-dependent records) into isolated user interfaces. Because each dataset employed different normalization methods and geographical resolutions, a single county appeared as severe risk on the flood index yet low risk on the demographic vulnerability table, creating ambiguity during evacuation planning.</p>

          <h3>Standardizing on county FIPS and centralized metric derivation</h3>
          <p>The architecture consolidated all data layers around five-digit county FIPS codes as the single relational join key across 3,144 United States counties. The ingestion process resolved 47 malformed FIPS records in legacy FEMA tables where leading zeros were stripped by spreadsheet parsers. An analytical preprocessing step calculates six derived indicators once at build time: digital alert access risk, daytime population surge, hazard impact potential, medical electricity dependence, evacuation mobility deficits, and communication redundancy. The choropleth map, tabular views, legend components, and county detail panels share a unified severity scale, ensuring data consistency across all views.</p>

          <h3>URL state serialization for operational coordination</h3>
          <p>Emergency analysts need to share exact data views with distributed field teams without generating static exports. The interface synchronizes every active filter, search query, selected county, and risk threshold to URL parameters. Pasting the generated link restores the exact map viewport, table filters, column sorting, and active county dossier instantly.</p>
        </>}
      </div>
    </section>

    <footer class="project-footer"><a href="/work/">← All work</a><a href="/resume/">Resume →</a></footer>
  </main>
</Base>

<style>
  .project-page { max-width: 1120px; margin: 0 auto; padding: 2rem 1.5rem 6rem; }
  .back-nav { font-size: var(--fs-meta); color: var(--color-muted); margin-bottom: 5rem; }
  .back-nav a { color: inherit; }
  .project-header { max-width: 800px; }
  .eyebrow, .detail-label { font-size: var(--fs-eyebrow); font-weight: 500; letter-spacing: var(--tracking-widest); text-transform: uppercase; color: var(--color-muted); }
  h1 { font-family: var(--font-heading); font-weight: 400; font-size: clamp(4rem, 10vw, 8rem); line-height: .9; letter-spacing: var(--tracking-display); margin: .8rem 0 1.5rem; }
  .question { font-family: var(--font-heading); font-style: italic; font-size: clamp(1.3rem, 3vw, 1.8rem); color: var(--bronze-4); margin-bottom: 1.5rem; }
  .lede { color: var(--color-secondary); font-size: var(--fs-lead); line-height: var(--leading-body); max-width: 48rem; }
  .links { display: flex; gap: 1.5rem; margin-top: 2rem; }
  .links a, .project-footer a { color: var(--color-text); font-weight: 500; }
  .preview { margin: 5rem 0; }
  .preview img { display: block; width: 100%; height: auto; border: var(--border-hair); }
  .preview figcaption { margin-top: .65rem; color: var(--color-muted); font-size: var(--fs-meta); letter-spacing: var(--tracking-wide); }
  .details { display: grid; grid-template-columns: 1fr 1fr; gap: 0; border-top: var(--border-hair); }
  .detail-block { padding: 2rem 0; border-bottom: var(--border-hair); }
  .detail-block:nth-child(2) { padding-left: 2rem; border-left: var(--border-hair); }
  .detail-block > p:last-child { margin-top: .65rem; color: var(--color-secondary); line-height: var(--leading-body); }
  .detail-block.wide { grid-column: 1 / -1; padding: 3rem 0; }
  h2 { font-family: var(--font-heading); font-size: var(--fs-h2); font-weight: 400; margin-bottom: 1.5rem; }
  .wide h3 { font-family: var(--font-body); font-size: 1.125rem; font-weight: 600; margin: 2.25rem 0 0.65rem; color: var(--color-text); }
  .wide h3:first-of-type { margin-top: 1.5rem; }
  .wide p { max-width: 48rem; margin-bottom: 1.25rem; color: var(--color-secondary); line-height: var(--leading-body); }
  .wide code { font-family: monospace; font-size: 0.9em; background: var(--paper-alt); padding: 0.15rem 0.35rem; border-radius: 3px; }
  .project-footer { display: flex; justify-content: space-between; margin-top: 4rem; padding-top: 2rem; border-top: var(--border-hair); }
  @media (max-width: 650px) { .details { grid-template-columns: 1fr; } .detail-block:nth-child(2) { padding-left: 0; border-left: 0; } }
</style>
