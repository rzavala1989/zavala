---
import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';
import { portfolioItems } from '../../data/portfolio';

const noteMetadata: Record<string, { tags: string[], headline: string }> = {
  enroll: {
    headline: 'Why registration capacity belongs inside the database transaction',
    tags: ['Distributed Systems', 'PostgreSQL', 'Concurrency']
  },
  nomadhood: {
    headline: 'Why weighted scoring was the wrong abstraction for neighborhood matching',
    tags: ['Data Modeling', 'Similarity Search', 'Recommendation Systems']
  },
  blaqjaq: {
    headline: 'Why I pulled the game engine completely out of React',
    tags: ['React', 'State Machines', 'Testing']
  },
  'emergency-lifeline-auditor': {
    headline: 'What breaks when five federal datasets disagree about geography',
    tags: ['Civic Data', 'Data Pipelines', 'Visualization']
  }
};

const notes = portfolioItems
  .filter(item => noteMetadata[item.slug])
  .map(item => ({
    slug: item.slug,
    description: item.description,
    meta: noteMetadata[item.slug]
  }));

const description = 'Engineering notes by Ricardo Zavala on distributed systems, data pipelines, product architecture, and frontend systems.';
---

<Base title="Engineering Notes | Ricardo Zavala" description={description} ogType="website">
  <main class="writing-page">
    <nav class="back-nav" aria-label="Breadcrumb"><a href="/">Ricardo Zavala</a> / Engineering Notes</nav>

    <header class="page-header">
      <p class="eyebrow">Engineering notes</p>
      <h1>Decisions worth explaining.</h1>
      <p class="lede">
        Short technical deep dives into constraints, failed approaches, tradeoffs, and the architecture that came out the other side.
      </p>
    </header>

    <section class="notes-list">
      {notes.map(note => (
        <article class="note-card">
          <h2><a href={`/work/${note.slug}/#engineering-notes`}>{note.meta.headline}</a></h2>
          <p class="note-summary">{note.description}</p>
          <div class="tags" aria-label="Topics">
            {note.meta.tags.map(tag => <span class="tag">{tag}</span>)}
          </div>
          <a class="read" href={`/work/${note.slug}/#engineering-notes`}>Read engineering notes <span aria-hidden="true">→</span></a>
        </article>
      ))}
    </section>
  </main>
  <Footer />
</Base>

<style>
  .writing-page { max-width: 980px; margin: 0 auto; padding: 2rem 1.5rem 6rem; }
  .back-nav { font-size: var(--fs-meta); color: var(--color-muted); margin-bottom: clamp(3rem, 8vw, 5rem); }
  .back-nav a { color: inherit; }
  .page-header { max-width: 780px; margin-bottom: 4rem; }
  .eyebrow { font-size: var(--fs-eyebrow); font-weight: 500; letter-spacing: var(--tracking-widest); text-transform: uppercase; color: var(--color-muted); }
  h1 { font-family: var(--font-heading); font-weight: 400; font-size: clamp(3rem, 8vw, 6rem); line-height: .95; letter-spacing: var(--tracking-display); margin: .8rem 0 1.5rem; }
  .lede { color: var(--color-secondary); font-size: var(--fs-lead); line-height: var(--leading-body); max-width: 44rem; }
  .notes-list { display: flex; flex-direction: column; }
  .note-card { padding: 2.2rem 0 2.5rem; border-top: var(--border-hair); }
  .note-card:last-child { border-bottom: var(--border-hair); }
  .note-card h2 { max-width: 46rem; font-family: var(--font-heading); font-size: var(--fs-h2); font-weight: 400; line-height: 1.15; letter-spacing: var(--tracking-display); }
  .note-card h2 a { color: var(--color-text); text-decoration: none; transition: color var(--dur-fast) ease; }
  .note-card h2 a:hover, .note-card h2 a:focus-visible { color: var(--bronze); }
  .note-summary { max-width: 44rem; margin-top: .85rem; color: var(--color-secondary); font-size: var(--fs-body); line-height: var(--leading-body); }
  .tags { display: flex; gap: .55rem; flex-wrap: wrap; margin-top: 1rem; }
  .tag { font-size: var(--fs-meta); color: var(--color-secondary); background: var(--paper-alt); padding: .28rem .65rem; border-radius: var(--radius-sm); }
  .read { display: inline-flex; align-items: center; gap: .35rem; margin-top: 1.2rem; color: var(--color-text); font-size: var(--fs-small); font-weight: 500; text-decoration: none; }
  .read:hover, .read:focus-visible { color: var(--bronze); }
</style>
