---
import Base from '../../layouts/Base.astro';
import { portfolioItems } from '../../data/portfolio';

// Mapping of tags for the writing page
const noteMetadata: Record<string, { tags: string[], headline: string, date: string }> = {
  enroll: {
    headline: 'Enroll: How I Stopped a Registration-Day Meltdown with PostgreSQL Row Locks',
    tags: ['Distributed Systems', 'PostgreSQL', 'Concurrency'],
    date: 'Jan 15, 2025'
  },
  nomadhood: {
    headline: 'Nomadhood: Fixing Neighborhood Recommendations with pgvector',
    tags: ['Full-stack', 'pgvector', 'Recommendation Engine'],
    date: 'Jan 15, 2025'
  },
  blaqjaq: {
    headline: 'Blaqjaq: Decoupling Game State from React with a Pure Reducer',
    tags: ['React', 'Game Engine', '3D rendering'],
    date: 'Jan 15, 2025'
  },
  'emergency-lifeline-auditor': {
    headline: 'Emergency Lifeline Auditor: Unifying Federal Datasets for Disaster Response',
    tags: ['Civic Data', 'Data Pipelines', 'Data Visualization'],
    date: 'Jan 15, 2025'
  }
};

const notes = portfolioItems
  .filter(item => noteMetadata[item.slug])
  .map(item => ({
    slug: item.slug,
    title: item.title,
    description: item.description,
    meta: noteMetadata[item.slug]
  }));

const description = "Technical writing and engineering notes by Ricardo Zavala on distributed systems, data pipelines, and UI architecture.";
---

<Base title="Writing & Engineering Notes | Ricardo Zavala" description={description}>
  <main class="writing-page">
    <nav class="back-nav" aria-label="Breadcrumb"><a href="/">Ricardo Zavala</a> / Writing</nav>

    <header class="page-header">
      <h1>Writing</h1>
      <p class="lede">Engineering stories, post-mortems, and architecture notes from building complex systems.</p>
    </header>

    <section class="notes-list">
      {notes.map(note => (
        <article class="note-card">
          <time datetime="2025-01-15">{note.meta.date}</time>
          <h2><a href={`/work/${note.slug}#engineering-notes`}>{note.meta.headline}</a></h2>
          <div class="tags">
            {note.meta.tags.map(tag => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        </article>
      ))}
    </section>

    <footer class="page-footer"><a href="/">← Back Home</a></footer>
  </main>
</Base>

<style>
  .writing-page { max-width: 1120px; margin: 0 auto; padding: 2rem 1.5rem 6rem; }
  .back-nav { font-size: var(--fs-meta); color: var(--color-muted); margin-bottom: 5rem; }
  .back-nav a { color: inherit; }
  .page-header { max-width: 800px; margin-bottom: 4rem; }
  h1 { font-family: var(--font-heading); font-weight: 400; font-size: clamp(4rem, 10vw, 8rem); line-height: .9; letter-spacing: var(--tracking-display); margin: .8rem 0 1.5rem; }
  .lede { color: var(--color-secondary); font-size: var(--fs-lead); line-height: var(--leading-body); max-width: 48rem; }
  
  .notes-list { display: flex; flex-direction: column; gap: 3rem; }
  .note-card { display: flex; flex-direction: column; gap: 0.5rem; padding-bottom: 3rem; border-bottom: var(--border-hair); }
  .note-card:last-child { border-bottom: none; }
  .note-card time { font-size: var(--fs-meta); color: var(--color-muted); letter-spacing: var(--tracking-wide); text-transform: uppercase; }
  .note-card h2 { font-family: var(--font-heading); font-size: var(--fs-h2); font-weight: 400; line-height: 1.1; }
  .note-card h2 a { color: var(--color-text); text-decoration: none; }
  .note-card h2 a:hover { color: var(--bronze-4); text-decoration: underline; }
  
  .tags { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 0.5rem; }
  .tag { font-size: var(--fs-meta); color: var(--color-secondary); background: var(--paper-alt); padding: 0.25rem 0.75rem; border-radius: 999px; }
  
  .page-footer { margin-top: 4rem; padding-top: 2rem; border-top: var(--border-hair); }
  .page-footer a { color: var(--color-text); font-weight: 500; }
</style>
