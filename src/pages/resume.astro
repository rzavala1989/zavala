---
import Base from '../layouts/Base.astro';

const experience = [
  {
    role: 'Co-Founding Backend Engineer',
    company: 'Arkra',
    dates: 'May 2025 - Present',
    bullets: [
      'Architecting full-stack services for an AI-powered fintech marketplace using TypeScript, Node.js, Python, PostgreSQL, and React.',
      'Designing event-driven transaction flows with partitioned messaging and idempotency for retries and reordering.',
      'Building AI-assisted matching and underwriting pipelines with RAG, vector search, human review, guardrails, and evaluation harnesses.',
    ],
  },
  {
    role: 'Senior Full Stack Engineer',
    company: 'Avenue Code',
    dates: 'April 2025 - December 2025',
    bullets: [
      'Led a secure multi-tenant data platform across React, TypeScript, FastAPI, and PostgreSQL.',
      'Built RBAC, immutable audit trails, FIPS-validated cryptography, and tenant isolation for regulated workflows.',
      'Increased ingestion throughput by 40% with async services, distributed task queues, and partitioned streaming.',
    ],
  },
  {
    role: 'Senior Full Stack Engineer',
    company: 'Accenture Federal Services',
    dates: 'April 2022 - April 2025',
    bullets: [
      'Architected AWS services supporting 3M+ daily transactions at sub-50ms p99 latency across peak traffic.',
      'Owned GraphQL and REST API design across 14 services and standardized React and TypeScript UI patterns across 22 teams.',
      'Engineered PCI-compliant payment integrations with PayPal, Stripe, Square, and Fiserv.',
    ],
  },
  {
    role: 'Full Stack Engineer',
    company: 'Cigna',
    dates: 'February 2022 - April 2022',
    bullets: [
      'Built shared React and Material UI systems inside a HIPAA-regulated healthcare environment.',
      'Improved provider search performance with React Query and Elasticsearch and added New Relic observability for React and Django services.',
    ],
  },
  {
    role: 'Web and Native Mobile Developer',
    company: 'Zappos Family of Companies',
    dates: 'October 2018 - August 2021',
    bullets: [
      'Worked on consumer payment surfaces serving 18.5M+ monthly transactions with 99.99% uptime through peak events.',
      'Designed a GraphQL federation layer that consolidated 12 legacy REST APIs and reduced frontend over-fetching by 76%.',
    ],
  },
];
---

<Base
  title="Ricardo Zavala Resume | Staff Software Engineer"
  description="Resume for Ricardo Zavala, a Staff Software Engineer in Tulsa, Oklahoma with 10 years across React, TypeScript, Node.js, Python, Go, PostgreSQL, AWS, distributed systems, fintech, healthcare, and regulated platforms."
>
  <main class="resume-shell">
    <header class="resume-header">
      <p class="eyebrow">Resume</p>
      <h1>Ricardo Zavala</h1>
      <p class="role">Staff Software Engineer</p>
      <p class="meta">Tulsa, OK · Remote US</p>
      <p class="lede">
        Staff-level full-stack engineer with 10 years owning systems end to end across React, TypeScript, Node.js,
        Python, Go, PostgreSQL, AWS, and distributed architectures. I work best where product decisions, backend
        correctness, and production reliability all meet.
      </p>
      <nav class="resume-links" aria-label="Resume links">
        <a href="/">Portfolio</a>
        <a href="https://github.com/rzavala1989" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="mailto:zavala.ricardo.m@gmail.com">Email</a>
      </nav>
    </header>

    <section>
      <h2>Experience</h2>
      {experience.map((item) => (
        <article class="job">
          <div class="job-heading">
            <div>
              <h3>{item.role}</h3>
              <p class="company">{item.company}</p>
            </div>
            <p class="dates">{item.dates}</p>
          </div>
          <ul>
            {item.bullets.map((bullet) => <li>{bullet}</li>)}
          </ul>
        </article>
      ))}
    </section>

    <section>
      <h2>Core stack</h2>
      <p class="stack">
        React, Next.js, TypeScript, Node.js, Python, FastAPI, Django, Go, REST, GraphQL, gRPC, PostgreSQL,
        MongoDB, Redis, Elasticsearch, pgvector, Kafka, AWS, Azure, Terraform, Docker, Kubernetes, GitHub Actions,
        CI/CD, New Relic, Datadog, Jest, Cypress, Playwright, PyTest.
      </p>
    </section>

    <section>
      <h2>Focus areas</h2>
      <p class="stack">
        Distributed systems, event-driven architecture, payments, regulated data platforms, multi-tenant systems,
        AI-assisted workflows, RAG, human-in-the-loop systems, observability, API design, frontend platforms, and developer tooling.
      </p>
    </section>

    <section>
      <h2>Education</h2>
      <p>Bachelor of Science, Computer Science · University of Nevada, Las Vegas · 2018 · cum laude</p>
    </section>
  </main>
</Base>

<style>
  .resume-shell {
    width: min(900px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 5rem 0 6rem;
  }

  .resume-header {
    padding-bottom: 3rem;
    border-bottom: var(--border-hair);
    margin-bottom: 3rem;
  }

  .eyebrow,
  .meta,
  .dates {
    font-size: var(--fs-meta);
    letter-spacing: var(--tracking-wide);
    color: var(--color-muted);
  }

  .eyebrow {
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-heading);
    font-weight: 400;
  }

  h1 {
    font-size: clamp(3rem, 8vw, 6rem);
    line-height: 0.95;
  }

  .role {
    margin-top: 1rem;
    font-size: 1.1rem;
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
  }

  .meta {
    margin-top: 0.75rem;
  }

  .lede {
    max-width: 720px;
    margin-top: 1.5rem;
    font-size: var(--fs-lead);
    line-height: var(--leading-body);
    color: var(--color-secondary);
  }

  .resume-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 2rem;
  }

  .resume-links a {
    color: var(--color-text);
    text-underline-offset: 0.25em;
  }

  section + section {
    margin-top: 3.5rem;
  }

  h2 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 1.5rem;
  }

  .job {
    padding: 1.5rem 0;
    border-top: var(--border-hair);
  }

  .job-heading {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    align-items: baseline;
  }

  h3 {
    font-size: 1.4rem;
  }

  .company {
    margin-top: 0.25rem;
    color: var(--color-secondary);
  }

  ul {
    margin: 1rem 0 0 1.25rem;
    color: var(--color-secondary);
  }

  li + li {
    margin-top: 0.5rem;
  }

  li,
  .stack,
  section > p {
    line-height: 1.7;
  }

  .stack {
    color: var(--color-secondary);
  }

  @media (max-width: 640px) {
    .resume-shell {
      padding-top: 3rem;
    }

    .job-heading {
      display: block;
    }

    .dates {
      margin-top: 0.5rem;
    }
  }
</style>
