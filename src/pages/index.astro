---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Projects from '../components/Projects.astro';
import Timeline from '../components/Timeline.astro';
import Lab from '../components/Lab.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Ricardo Zavala | Staff Software Engineer"
  description="Ricardo Zavala is a Staff Software Engineer in Henderson, Nevada with 10 years across React, TypeScript, Node.js, Python, Go, PostgreSQL, AWS, distributed systems, fintech, healthcare, and AI-assisted products."
>
  <Hero />
  <Projects />
  <Timeline />
  <div class="section-alt">
    <Lab />
  </div>
  <Footer />
</Base>

<style>
  .section-alt {
    background-color: var(--paper-alt);
  }
</style>
